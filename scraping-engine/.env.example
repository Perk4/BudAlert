# Convex Configuration (required)
CONVEX_URL=https://your-project.convex.cloud
VITE_CONVEX_URL=https://your-project.convex.cloud

# Parent Database (optional - for seeding from main BudAlert DB)
PARENT_CONVEX_URL=https://parent-project.convex.cloud

# Orchestration Settings (optional)
CONCURRENCY=5
DELAY_MS=5000
CHECK_INTERVAL_MS=3600000
MAX_PER_CYCLE=50

# Debug (optional)
DEBUG=*
