{
  "name": "@budalert/scraping-engine",
  "version": "0.1.0",
  "description": "Continuous scraping research engine for NY dispensaries",
  "type": "module",
  "scripts": {
    "dev": "npm run convex:dev",
    "build": "tsc",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "seed:nys": "node scripts/seed-nys.mjs",
    "cluster:detect": "node scripts/cluster-detect.mjs",
    "cluster:stats": "node scripts/cluster-stats.mjs",
    "research:cluster": "node scripts/research-cluster.mjs",
    "research:all": "node scripts/research-all.mjs",
    "retry:blocked": "node scripts/retry-blocked.mjs",
    "continuous": "node scripts/continuous.mjs",
    "status": "node scripts/status.mjs",
    "test": "vitest",
    "test:watch": "vitest watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "convex": "^1.16.0",
    "playwright": "^1.42.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
